---
import { nav, site } from '../data/content';
---

<header
  class="sticky top-0 z-40 border-b border-line-soft bg-base/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
    <a href="#top" class="group flex shrink-0 items-center gap-2.5">
      <img
        src="/media/msw-logo.svg"
        alt=""
        width="28"
        height="28"
        class="h-7 w-7 rounded-[6px] bg-white p-[5px] transition-opacity group-hover:opacity-80"
      />
      <span class="text-[15px] font-semibold tracking-tight text-ink">{site.name}</span>
    </a>

    <nav aria-label="主导航" class="ml-auto hidden items-center gap-7 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-[13px] text-ink-2 transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <a
        href="https://github.com/mswjs/msw"
        target="_blank"
        rel="noreferrer"
        class="hidden rounded-control px-3 py-2 font-mono text-xs text-ink-2 transition-colors hover:text-ink sm:block"
      >
        GitHub
      </a>
      <a
        href={site.primaryCta.href}
        target="_blank"
        rel="noreferrer"
        class="rounded-control bg-ink px-3.5 py-2 text-[13px] font-medium whitespace-nowrap text-base transition-transform duration-200 active:scale-[0.98] sm:px-4"
      >
        {site.primaryCta.label}
      </a>

      <details class="relative lg:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-control border border-line text-ink-2 transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="打开导航菜单"
        >
          <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"></path>
          </svg>
        </summary>
        <nav
          aria-label="移动端导航"
          class="absolute right-0 top-11 w-44 overflow-hidden rounded-panel border border-line bg-raised p-1.5 shadow-[0_16px_40px_rgba(0,0,0,0.5)]"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="block rounded-control px-3 py-2 text-sm text-ink-2 transition-colors hover:bg-panel hover:text-ink"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="https://github.com/mswjs/msw"
            target="_blank"
            rel="noreferrer"
            class="block rounded-control px-3 py-2 text-sm text-ink-2 transition-colors hover:bg-panel hover:text-ink"
          >
            GitHub
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
